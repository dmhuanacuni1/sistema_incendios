# ============================================================
# Plantilla de variables de entorno del backend
# Copiar a .env (o usar el .env.local de la raíz) y completar.
# NUNCA subir el archivo real a git.
# ============================================================

# --- Opción Neon (recomendada para el equipo) ---
# La cadena real ya está en .env.local de la raíz, generada por `neon init`.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Opción PostgreSQL local compartido entre laptops ---
# Cambiar HOST por la IP del equipo que hospeda la base (nunca localhost en la demo).
# DATABASE_URL=postgresql://app_incendios:clave@HOST:5432/incendios?sslmode=disable

# --- Entorno ---
# El servidor se levanta con `flask run` (FLASK_APP está en .flaskenv).

# --- Sesión (sprint de usuarios) ---
# Clave para firmar los tokens. Generar una distinta en cada máquina.
SECRET_KEY=cambia-esta-clave
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
JWT_RESET_MINUTES=60
FRONTEND_URL=http://127.0.0.1:5173

# Correo de recuperación: copia backend/correo.env.example a backend/correo.env
# y completa SMTP_USER y SMTP_PASSWORD. Ese archivo no se sube a git.
