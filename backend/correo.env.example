# Copia este archivo a backend/correo.env y completa los datos.
# correo.env no se sube a git.
# En Gmail, SMTP_PASSWORD es una contraseña de aplicación de 16 caracteres,
# no la clave con la que entras al correo. Hace falta verificación en 2 pasos.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
